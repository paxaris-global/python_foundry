APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change_me_in_production

POSTGRES_USER=ai_codegen
POSTGRES_PASSWORD=ai_codegen_pass
POSTGRES_DB=ai_codegen_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_TELEMETRY=false
ANONYMIZED_TELEMETRY=false
CHROMA_PRODUCT_TELEMETRY_IMPL=app.services.rag.noop_telemetry.NoOpProductTelemetryClient
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_MODEL=claude-3-opus-20240229

ANTHROPIC_TIMEOUT_SECONDS=60
STORE_FINAL_PROJECT=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LOG_LLM_PROMPTS=true
LLM_PROMPT_LOG_MAX_CHARS=20000

SEARCH_PROVIDER=serpapi
SEARCH_API_KEY=
SEARCH_ENGINE=google_light
FALLBACK_SEARCH_PROVIDER=duckduckgo
GITHUB_TOKEN=
SEARCH_TIMEOUT_SECONDS=10
ENABLE_PLAYWRIGHT=false
ALLOWED_WEB_DOMAINS=github.com,docs.github.com,spring.io,angular.dev
DENIED_WEB_DOMAINS=
MAX_WEB_RESULTS=10
MAX_WEB_FETCH_PAGES=5
MAX_REPO_FILES=150
MAX_PROMPT_DEBUG_SIZE=200000

MAX_RAG_RESULTS=8
MAX_GENERATION_FILE_SIZE=500000
MAX_GENERATED_FILE_COUNT=600
MAX_ZIP_SIZE_MB=50
RAG_MIN_SIMILARITY=0.0

DOWNLOADS_DIR=./downloads
