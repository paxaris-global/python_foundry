<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Modern AI Generated App</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Roboto:wght@400;700&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Inter', 'Roboto', Arial, sans-serif;
      background: linear-gradient(120deg, #f8fafc 0%, #e0e7ef 100%);
      color: #22223b;
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="utf-8" />
      <title>Modern AI Generated App</title>
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
      <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
      <link href="https://cdn.jsdelivr.net/npm/@angular/material@16.2.0/prebuilt-themes/indigo-pink.css" rel="stylesheet">
      <style>
        body {
          margin: 0;
          font-family: 'Roboto', Arial, sans-serif;
          background: #f4f6fb;
          color: #22223b;
        }
        .mat-toolbar {
          position: sticky;
          top: 0;
          z-index: 1000;
        }
        main {
          max-width: 960px;
          margin: 2.5rem auto;
          background: #fff;
          border-radius: 1.2rem;
          box-shadow: 0 4px 24px rgba(0,0,0,0.07);
          padding: 2.5rem 2rem;
        }
        .hero {
          text-align: center;
          margin-bottom: 2.5rem;
        }
        .hero-title {
          font-size: 2.5rem;
          font-weight: 700;
          color: #1976d2;
          margin-bottom: 0.5rem;
        }
        .hero-desc {
          font-size: 1.25rem;
          color: #555;
          margin-bottom: 2rem;
        }
        .feature-list {
          display: flex;
          flex-wrap: wrap;
          gap: 2rem;
          justify-content: center;
          margin-bottom: 2.5rem;
        }
        .feature-card {
          background: #f8fafc;
          border-radius: 1rem;
          box-shadow: 0 2px 8px rgba(0,0,0,0.04);
          padding: 1.5rem 1.2rem;
          min-width: 220px;
          max-width: 320px;
          flex: 1 1 220px;
          text-align: center;
        }
        footer {
          text-align: center;
          color: #888;
          font-size: 1rem;
          margin: 3rem 0 1rem 0;
        }
      background: #2563eb;
      </style>
      padding: 0.75rem 2rem;
      font-size: 1.1rem;
      <mat-toolbar color="primary">
        <span style="font-weight:700;font-size:1.5rem;">Modern AI Generated App</span>
        <span class="spacer"></span>
        <a mat-button href="#">Home</a>
        <a mat-button href="#features">Features</a>
        <a mat-button href="#contact">Contact</a>
      </mat-toolbar>
      <main>
        <section class="hero">
          <div class="hero-title">Welcome to your new app!</div>
          <div class="hero-desc">A beautiful, professional Angular template powered by AI and Angular Material.</div>
        </section>
        <section class="feature-list">
          <div class="feature-card">
            <span class="material-icons" style="font-size:2.5rem;color:#1976d2;">devices</span>
            <h3>Responsive Design</h3>
            <p>Looks great on any device, from mobile to desktop.</p>
          </div>
          <div class="feature-card">
            <span class="material-icons" style="font-size:2.5rem;color:#1976d2;">bolt</span>
            <h3>Fast & Modern</h3>
            <p>Built with Angular Material for speed and style.</p>
          </div>
          <div class="feature-card">
            <span class="material-icons" style="font-size:2.5rem;color:#1976d2;">build</span>
            <h3>Easy to Customize</h3>
            <p>Clean code and flexible structure for rapid development.</p>
          </div>
        </section>
        <section>
          <h3>Get Started</h3>
          <p>Edit <code>src/app/app.component.html</code> to begin building your app.</p>
        </section>
      </main>
      <footer>
        &copy; {{ year or '2026' }} Modern AI Generated App. All rights reserved.
      </footer>
    </body>
    </html>
</html>
