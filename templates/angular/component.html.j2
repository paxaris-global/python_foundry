<div class="storefront">
  <mat-drawer-container class="storefront-shell" autosize>
    <!-- Right drawer: add/edit -->
    <mat-drawer class="sidepanel" position="end" mode="over" [opened]="showAddForm">
      <div class="sidepanel-header">
        <div class="sidepanel-title">
          <div class="title">{{ isEditMode ? 'Edit' : 'Add' }} {{ entity_name }}</div>
          <div class="subtitle">{{ isEditMode ? 'Update details' : 'Create a new entry' }}</div>
        </div>
        <button mat-icon-button (click)="cancelEdit()" aria-label="Close">
          <mat-icon>close</mat-icon>
        </button>
      </div>

      <form [formGroup]="addForm" (ngSubmit)="isEditMode ? updateCustomer() : addCustomer()" class="sidepanel-form">
        <mat-form-field appearance="outline">
          <mat-label>{{ entity_name }} Name</mat-label>
          <input matInput formControlName="name" placeholder="e.g. John Doe" />
          <mat-error *ngIf="isFieldInvalid(addForm, 'name')">{{ getFieldErrorMessage(addForm, 'name') }}</mat-error>
        </mat-form-field>

        <mat-form-field appearance="outline">
          <mat-label>Email</mat-label>
          <input matInput type="email" formControlName="email" placeholder="john@example.com" />
          <mat-error *ngIf="isFieldInvalid(addForm, 'email')">{{ getFieldErrorMessage(addForm, 'email') }}</mat-error>
        </mat-form-field>

        <mat-form-field appearance="outline">
          <mat-label>Company</mat-label>
          <input matInput formControlName="company" placeholder="Optional" />
        </mat-form-field>

        <mat-form-field appearance="outline">
          <mat-label>Phone</mat-label>
          <input matInput formControlName="phone" placeholder="Optional" />
        </mat-form-field>

        <mat-form-field appearance="outline">
          <mat-label>Address</mat-label>
          <textarea matInput rows="3" formControlName="address" placeholder="Optional"></textarea>
        </mat-form-field>

        <div class="sidepanel-actions">
          <button mat-button type="button" (click)="cancelEdit()">Cancel</button>
          <button mat-flat-button color="primary" type="submit" [disabled]="addForm.invalid || loading">
            <mat-icon *ngIf="!loading">{{ isEditMode ? 'save' : 'add' }}</mat-icon>
            <mat-spinner diameter="18" *ngIf="loading"></mat-spinner>
            {{ isEditMode ? 'Save changes' : 'Add' }}
          </button>
        </div>
      </form>
    </mat-drawer>

    <!-- Main content -->
    <mat-drawer-content>
      <div class="page">
        <!-- Search + actions -->
        <div class="searchbar">
          <mat-form-field appearance="outline" class="searchbar-field">
            <mat-label>Search {{ entity_name | lowercase }}s</mat-label>
            <mat-icon matPrefix>search</mat-icon>
            <input
              matInput
              [value]="searchQuery"
              (input)="applySearch(($any($event.target)).value)"
              placeholder="Search by name, email, or company"
            />
            <button
              mat-icon-button
              matSuffix
              type="button"
              aria-label="Clear search"
              *ngIf="searchQuery"
              (click)="applySearch('')"
            >
              <mat-icon>close</mat-icon>
            </button>
          </mat-form-field>

          <div class="searchbar-actions">
            <button mat-stroked-button type="button" (click)="refresh()" [disabled]="loading">
              <mat-icon>refresh</mat-icon>
              Refresh
            </button>
            <button mat-flat-button color="primary" type="button" (click)="openAdd()">
              <mat-icon>add</mat-icon>
              Add {{ entity_name }}
            </button>
          </div>
        </div>

        <!-- Hero banner -->
        <div class="hero">
          <div class="hero-copy">
            <div class="hero-kicker">{{ project_name | title }}</div>
            <h2 class="hero-title">A modern storefront-style UI</h2>
            <p class="hero-subtitle">
              Browse, search, and manage your {{ entity_name | lowercase }}s with a clean catalog layout.
            </p>
            <div class="hero-cta">
              <button mat-flat-button color="primary" type="button" (click)="openAdd()">
                <mat-icon>add</mat-icon>
                Create {{ entity_name }}
              </button>
              <button mat-button type="button" (click)="applySearch('')" [disabled]="!searchQuery">
                Clear filters
              </button>
            </div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="hero-badge">
              <mat-icon>local_mall</mat-icon>
              <span>Pro UI</span>
            </div>
            <div class="hero-metrics">
              <div class="metric">
                <div class="metric-value">{{ customers?.length || 0 }}</div>
                <div class="metric-label">{{ entity_name }}s</div>
              </div>
              <div class="metric">
                <div class="metric-value">Fast</div>
                <div class="metric-label">Search</div>
              </div>
              <div class="metric">
                <div class="metric-value">Clean</div>
                <div class="metric-label">Cards</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Loading -->
        <div *ngIf="loading && !customers" class="loading">
          <mat-spinner diameter="44"></mat-spinner>
          <div class="loading-text">Loading {{ entity_name | lowercase }}s…</div>
        </div>

        <!-- Empty state -->
        <mat-card class="empty" *ngIf="!loading && (dataSource?.filteredData?.length || 0) === 0">
          <mat-card-content>
            <div class="empty-icon">
              <mat-icon>inventory_2</mat-icon>
            </div>
            <div class="empty-title">No results</div>
            <div class="empty-subtitle">Try a different search, or add your first {{ entity_name | lowercase }}.</div>
            <div class="empty-actions">
              <button mat-flat-button color="primary" type="button" (click)="openAdd()">
                <mat-icon>add</mat-icon>
                Add {{ entity_name }}
              </button>
              <button mat-button type="button" (click)="applySearch('')" [disabled]="!searchQuery">
                Clear search
              </button>
            </div>
          </mat-card-content>
        </mat-card>

        <!-- Catalog grid -->
        <div class="grid" *ngIf="(dataSource?.filteredData?.length || 0) > 0">
          <mat-card class="card" *ngFor="let customer of dataSource.filteredData">
            <mat-card-header>
              <div mat-card-avatar class="avatar">
                {{ customer.name?.[0] || '?' }}
              </div>
              <mat-card-title class="card-title">{{ customer.name }}</mat-card-title>
              <mat-card-subtitle class="card-subtitle">{{ customer.company || '—' }}</mat-card-subtitle>
            </mat-card-header>

            <mat-card-content class="card-content">
              <div class="meta">
                <mat-icon>mail</mat-icon>
                <span class="truncate">{{ customer.email }}</span>
              </div>
              <div class="meta" *ngIf="customer.phone">
                <mat-icon>call</mat-icon>
                <span class="truncate">{{ customer.phone }}</span>
              </div>
              <div class="meta" *ngIf="customer.address">
                <mat-icon>location_on</mat-icon>
                <span class="truncate">{{ customer.address }}</span>
              </div>
            </mat-card-content>

            <mat-card-actions align="end" class="card-actions">
              <button mat-button type="button" (click)="editCustomer(customer)">
                <mat-icon>edit</mat-icon>
                Edit
              </button>
              <button mat-button color="warn" type="button" (click)="deleteCustomer(customer)">
                <mat-icon>delete</mat-icon>
                Delete
              </button>
            </mat-card-actions>
          </mat-card>
        </div>
      </div>
    </mat-drawer-content>
  </mat-drawer-container>
</div>
