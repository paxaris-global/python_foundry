/* ── 2. Base reset & typography ────────────────────────────────────── */
html, body {
  margin: 0;
  min-height: 100%;
  font-family: var(--font-family);
  color: var(--clr-text);
}

*, *::before, *::after { box-sizing: border-box; }

a { color: var(--clr-primary); text-decoration: none; }
a:hover { color: var(--clr-primary-dark); }

/* ── 3. Angular Material overrides ─────────────────────────────────── */
.mat-mdc-card {
  border-radius: 14px !important;
  background: var(--clr-surface) !important;
  box-shadow: 0 4px 20px var(--clr-shadow) !important;
}
.mat-mdc-raised-button { border-radius: 8px !important; }
.mat-toolbar { background: var(--clr-surface) !important; color: var(--clr-text) !important; }

/* ══════════════════════════════════════════════════════════════════════
   ECOMMERCE LAYOUT  (.ec-*)
   ══════════════════════════════════════════════════════════════════════ */
{% if domain == "ecommerce" %}
/* ─ Navbar ─────────────────────────────────────────────────────────── */
.ec-navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  height: 64px;
  background: var(--clr-surface);
  border-bottom: 1px solid var(--clr-border);
  box-shadow: 0 2px 8px var(--clr-shadow);
  gap: 24px;
}
.ec-logo {
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: -0.5px;
  color: var(--clr-primary);
  white-space: nowrap;
}
.ec-categories { display: flex; gap: 4px; }
.ec-cat-link {
  font-size: 0.85rem;
  font-weight: 600;
  padding: 6px 12px;
  border-radius: 20px;
  color: var(--clr-text);
  transition: background 0.2s, color 0.2s;
  white-space: nowrap;
}
.ec-cat-link:hover, .ec-cat-link.active {
  background: var(--clr-primary);
  color: #fff;
}
.ec-search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--clr-surface-alt);
  border: 1px solid var(--clr-border);
  border-radius: 24px;
  padding: 6px 16px;
  max-width: 480px;
}
.ec-search-bar mat-icon { color: var(--clr-text-muted); font-size: 20px; }
.ec-search-bar input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  font-size: 0.9rem;
  color: var(--clr-text);
  font-family: var(--font-family);
}
.ec-search-bar input::placeholder { color: var(--clr-text-muted); }
.ec-nav-right { display: flex; align-items: center; gap: 4px; }
.ec-nav-right button { color: var(--clr-text); }
.ec-nav-right .mat-mdc-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 0.72rem;
  min-width: 56px;
  height: 56px;
}

/* ─ Banner / Hero ───────────────────────────────────────────────────── */
.ec-banner {
  position: relative;
  width: 100%;
  height: 340px;
  overflow: hidden;
  background: var(--clr-surface-alt);
}
.ec-banner img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.ec-banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(0,0,0,0.55) 0%, transparent 60%);
  display: flex;
  align-items: center;
  padding: 0 60px;
}
.ec-banner-text { color: #fff; }
.ec-banner-text h1 { font-size: 2.4rem; font-weight: 800; margin: 0 0 8px; }
.ec-banner-text p  { font-size: 1.1rem; margin: 0 0 20px; opacity: 0.9; }
.ec-banner-text button {
  background: var(--clr-primary);
  color: #fff;
  font-weight: 700;
  border-radius: 4px;
  padding: 10px 28px;
  font-size: 0.95rem;
  border: none;
  cursor: pointer;
  transition: background 0.2s;
}
.ec-banner-text button:hover { background: var(--clr-primary-dark); }

/* ─ Page layout ─────────────────────────────────────────────────────── */
.ec-page { min-height: 100vh; background: var(--clr-bg); }
.ec-shop-layout {
  display: flex;
  max-width: 1440px;
  margin: 0 auto;
  padding: 20px 16px;
  gap: 20px;
  align-items: flex-start;
}

/* ─ Filters sidebar ─────────────────────────────────────────────────── */
.ec-filters {
  width: 240px;
  min-width: 220px;
  flex-shrink: 0;
  background: var(--clr-surface);
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 12px var(--clr-shadow);
  position: sticky;
  top: 76px;
}
.ec-filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--clr-border);
}
.ec-filter-header h2 {
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  color: var(--clr-text);
  margin: 0;
}
.ec-clear-btn {
  background: none;
  border: none;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--clr-primary);
  cursor: pointer;
}
.ec-filter-section { margin-bottom: 20px; }
.ec-filter-title {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.8px;
  color: var(--clr-text-muted);
  margin: 0 0 10px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--clr-border);
}
.ec-category-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.ec-chip {
  background: var(--clr-surface-alt);
  border: 1px solid var(--clr-border);
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--clr-text);
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
}
.ec-chip:hover, .ec-chip.active {
  background: var(--clr-primary);
  border-color: var(--clr-primary);
  color: #fff;
}
.ec-range-slider {
  width: 100%;
  margin: 8px 0;
  accent-color: var(--clr-primary);
}
.ec-price-labels {
  display: flex;
  justify-content: space-between;
  font-size: 0.78rem;
  color: var(--clr-text-muted);
}
.ec-filter-checkboxes { display: flex; flex-direction: column; gap: 6px; }
.ec-checkbox-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.82rem;
  color: var(--clr-text);
  cursor: pointer;
}
.ec-checkbox-label input[type=checkbox] { accent-color: var(--clr-primary); }

/* ─ Main content ─────────────────────────────────────────────────────── */
.ec-main { flex: 1; min-width: 0; }
.ec-sort-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  padding: 10px 16px;
  background: var(--clr-surface);
  border-radius: 8px;
  box-shadow: 0 1px 6px var(--clr-shadow);
}
.ec-results-count { font-size: 0.88rem; color: var(--clr-text-muted); }
.ec-sort-options { display: flex; gap: 6px; flex-wrap: wrap; }
.ec-sort-btn {
  background: none;
  border: 1px solid var(--clr-border);
  border-radius: 4px;
  padding: 4px 10px;
  font-size: 0.78rem;
  color: var(--clr-text-muted);
  cursor: pointer;
  transition: all 0.15s;
}
.ec-sort-btn:hover, .ec-sort-btn.active {
  background: var(--clr-primary);
  border-color: var(--clr-primary);
  color: #fff;
}

/* ─ Product grid ─────────────────────────────────────────────────────── */
.ec-product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 16px;
}
.ec-product-card {
  background: var(--clr-surface);
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 2px 10px var(--clr-shadow);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  display: flex;
  flex-direction: column;
}
.ec-product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px var(--clr-shadow);
}
.ec-card-image-wrap {
  position: relative;
  aspect-ratio: 3/4;
  overflow: hidden;
  background: var(--clr-surface-alt);
}
.ec-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
  display: block;
}
.ec-product-card:hover .ec-card-img { transform: scale(1.05); }
.ec-wishlist-btn {
  position: absolute;
  top: 8px;
  right: 8px;
  background: rgba(255,255,255,0.9) !important;
  backdrop-filter: blur(4px);
  border-radius: 50% !important;
  width: 36px !important;
  height: 36px !important;
  min-width: 36px !important;
  padding: 0 !important;
}
.ec-wishlist-btn mat-icon { font-size: 18px; color: var(--clr-text-muted); }
.ec-wishlist-btn.active mat-icon { color: #e53935; }
.ec-discount-badge {
  position: absolute;
  bottom: 8px;
  left: 8px;
  background: #2ecc71;
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 3px 7px;
  border-radius: 4px;
}
.ec-card-body { padding: 10px 12px 6px; flex: 1; }
.ec-brand-name {
  font-size: 0.72rem;
  color: var(--clr-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin: 0 0 3px;
}
.ec-product-name {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--clr-text);
  margin: 0 0 8px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ec-price-row { display: flex; align-items: baseline; gap: 6px; margin-bottom: 4px; }
.ec-price-current { font-size: 1rem; font-weight: 700; color: var(--clr-text); }
.ec-price-original {
  font-size: 0.78rem;
  text-decoration: line-through;
  color: var(--clr-text-muted);
}
.ec-discount-text { font-size: 0.78rem; color: #2ecc71; font-weight: 600; }
.ec-rating-row { display: flex; align-items: center; gap: 6px; }
.ec-rating-badge {
  background: #2ecc71;
  color: #fff;
  font-size: 0.72rem;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 4px;
}
.ec-review-count { font-size: 0.72rem; color: var(--clr-text-muted); }
.ec-card-actions { padding: 8px 12px 12px; }
.ec-add-to-cart-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background: var(--clr-primary);
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 10px;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: background 0.2s;
}
.ec-add-to-cart-btn:hover:not(:disabled) { background: var(--clr-primary-dark); }
.ec-add-to-cart-btn:disabled { background: #9ca3af; cursor: not-allowed; }
.ec-add-to-cart-btn mat-icon { font-size: 16px; width: 18px; height: 18px; }

/* ─ Empty / Loading states ──────────────────────────────────────────── */
.ec-empty-state, .ec-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  color: var(--clr-text-muted);
  gap: 8px;
}
.ec-empty-state mat-icon { font-size: 56px; width: 56px; height: 56px; opacity: 0.4; }
.ec-empty-state h3 { font-size: 1.1rem; margin: 0; }
.ec-empty-state p { font-size: 0.88rem; margin: 0; }

{% endif %}

/* ══════════════════════════════════════════════════════════════════════
   HOTEL MANAGEMENT LAYOUT  (.hm-*)
   ══════════════════════════════════════════════════════════════════════ */
{% if domain == "hotel_management" %}
.hm-page { padding: 24px; background: var(--clr-bg); min-height: 100vh; }
.hm-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}
.hm-title { font-size: 1.6rem; font-weight: 700; margin: 0; color: var(--clr-text); }
.hm-form-card { margin-bottom: 24px; }
.hm-form {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 12px;
  padding: 8px 0;
}
.hm-card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 16px;
}
.hm-item-card {
  transition: transform 0.2s, box-shadow 0.2s;
}
.hm-item-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px var(--clr-shadow) !important;
}
.hm-field-row { display: flex; justify-content: space-between; padding: 4px 0; font-size: 0.85rem; }
.hm-field-label { color: var(--clr-text-muted); }
.hm-field-value { font-weight: 600; color: var(--clr-text); }
.hm-empty, .hm-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 20px;
  color: var(--clr-text-muted);
  gap: 8px;
}
.hm-empty mat-icon { font-size: 56px; width: 56px; height: 56px; opacity: 0.4; }
{% endif %}

