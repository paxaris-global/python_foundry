   ═══════════════════════════════════════════════════════════════════ */

/* ── 1. CSS Custom Properties (design-hint–driven defaults) ───────── */
{% if "dark" in design_hints %}
:root {
  --clr-primary:        #82b4ff;
  --clr-primary-dark:   #5b9af5;
  --clr-accent:         #f48fb1;
  --clr-bg:             #0f172a;
  --clr-surface:        #1e293b;
  --clr-surface-alt:    #263348;
  --clr-border:         rgba(255,255,255,0.08);
  --clr-text:           #f1f5f9;
  --clr-text-muted:     rgba(241,245,249,0.55);
  --clr-shadow:         rgba(0,0,0,0.55);
  --font-family:        "Segoe UI", "Inter", sans-serif;
}
body { background: radial-gradient(circle at top left, #1e293b 0%, #020617 80%); }
{% elif "luxury" in design_hints or "elegant" in design_hints %}
:root {
  --clr-primary:        #c9a84c;
  --clr-primary-dark:   #a8833a;
